# Copy to .env (gitignored) and fill in. scripts/submit_*.sh load it automatically;
# variables already set in the shell take precedence.
KAGGLE_API_TOKEN=          # Kaggle -> Settings -> API -> Create New Token (KGAT_...)
KAGGLE_KERNEL=             # <kaggle-username>/<kernel-slug>
HF_TOKEN=                  # Hugging Face token with write access
HF_BUCKET=                 # <hf-username>/<bucket>, mounted at /ckpt in HF Jobs
WANDB_API_KEY=             # optional
